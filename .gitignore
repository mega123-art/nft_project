# Datasets and footage are too big for git, but the unified class config
# is the one file in here the repo needs (git needs the dir un-ignored
# before a file inside it can be re-included).
data/*
!data/data.yaml
# Labelling conventions, the source list and the licence audit trail are
# documents, not data. They are useless if they only exist on one laptop.
!data/LABELLING.md
!data/video_sources.txt
!data/video_manifest.json
models/*.pt
logs/
runs/
__pycache__/
*.py[cod]
*.mp4
.venv/

# local Claude Code settings
.claude/settings.local.json
